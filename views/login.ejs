<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Вход · PQTV</title>
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" type="image/svg+xml" href="/assets/icons/icon.svg">
    <link rel="stylesheet" href="/assets/css/style.css?v=<%= assetVersion('/assets/css/style.css') %>">
</head>
<body class="login-page">
    <div class="login-card">
        <div class="login-logo"><img src="/logo/pqtv.svg" alt="PQTV"></div>
        <h2>Вход в PQTV</h2>
        <p class="login-sub">Единый вход для просмотра ТВ и панели управления</p>

        <% if (error) { %>
            <div class="error-msg"><%= error %></div>
        <% } %>
        <div id="unified-auth-msg" class="error-msg hidden"></div>

        <button type="button" id="btn-google-unified-login" class="btn btn-primary" style="width: 100%; padding: 13px; font-size: 14px;" tabindex="1">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
                <path d="M21.35 11.1h-9.17v2.73h6.51c-.33 3.81-3.5 5.44-6.5 5.44C8.36 19.27 5 16.25 5 12c0-4.1 3.2-7.27 7.2-7.27 3.09 0 4.9 1.97 4.9 1.97L19 4.72S16.56 2 12.1 2C6.42 2 2.03 6.8 2.03 12c0 5.05 4.13 10 10.22 10 5.35 0 9.25-3.67 9.25-9.09 0-1.15-.15-1.81-.15-1.81Z"/>
            </svg>
            Войти через Google
        </button>

        <div id="auth-newtab-hint" class="hidden" style="text-align:center; margin-top: 8px;">
            <a href="/login" target="_blank" rel="noopener noreferrer" style="font-size:12px; color:var(--primary-hi); text-decoration:underline;">
                Открыть вход в новой вкладке
            </a>
        </div>

        <div class="login-divider"><span>или по логину и паролю</span></div>

        <form action="/login" method="POST">
            <div class="form-group">
                <label>Логин или Email</label>
                <input type="text" name="login" required value="<%= loginInput %>" placeholder="Логин или email" autocomplete="username" tabindex="2">
            </div>
            <div class="form-group">
                <label>Пароль</label>
                <input type="password" name="password" required placeholder="••••••••" autocomplete="current-password" tabindex="3">
            </div>
            <button type="submit" class="btn btn-secondary" style="width: 100%; margin-top: 10px; padding: 12px;" tabindex="4">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                    <polyline points="10 17 15 12 10 7"/>
                    <line x1="15" y1="12" x2="3" y2="12"/>
                </svg>
                Войти по логину и паролю
            </button>
        </form>

        <div id="apk-download-strip" class="hidden" style="margin-top: 18px; padding-top: 14px; border-top: 1px dashed var(--border); text-align: center;">
            <a id="apk-direct-link" href="/apk/latest.apk" class="btn btn-secondary" style="width:100%; padding:9px 12px; font-size:12px;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                <span id="apk-download-label">Скачать APK для Android TV</span>
            </a>
        </div>

        <form id="admin-token-form" action="/editor" method="POST" class="hidden">
            <input type="hidden" id="admin-token-input" name="admin_token" value="">
        </form>
        <form id="watch-token-form" action="/watch" method="POST" class="hidden">
            <input type="hidden" id="watch-token-input" name="watch_token" value="">
        </form>
    </div>

    <script src="/assets/js/firebase-users.js?v=<%= assetVersion('/assets/js/firebase-users.js') %>"></script>
    <script>
        (function () {
            const btnGoogle = document.getElementById('btn-google-unified-login');
            const msgBox = document.getElementById('unified-auth-msg');
            const newTabHint = document.getElementById('auth-newtab-hint');
            const adminForm = document.getElementById('admin-token-form');
            const adminInput = document.getElementById('admin-token-input');
            const watchForm = document.getElementById('watch-token-form');
            const watchInput = document.getElementById('watch-token-input');

            function showMsg(text, isInfo) {
                if (!msgBox) return;
                msgBox.textContent = text;
                msgBox.classList.remove('hidden');
                if (isInfo) {
                    msgBox.style.background = 'rgba(99,102,241,0.14)';
                    msgBox.style.borderColor = 'rgba(99,102,241,0.4)';
                    msgBox.style.color = '#c7d2fe';
                } else {
                    msgBox.style.background = '';
                    msgBox.style.borderColor = '';
                    msgBox.style.color = '';
                }
            }

            function enterAdmin(token) {
                try { sessionStorage.setItem('pqtv_admin_token', token); } catch {}
                if (adminForm && adminInput) {
                    adminInput.value = token;
                    adminForm.submit();
                } else {
                    window.location.href = '/editor';
                }
            }

            function enterWatch(token) {
                try { if (token) sessionStorage.setItem('pqtv_watch_token', token); } catch {}
                if (watchForm && watchInput && token) {
                    watchInput.value = token;
                    watchForm.submit();
                } else {
                    window.location.href = '/watch';
                }
            }

            try {
                const params = new URLSearchParams(window.location.search);
                if (params.get('logged_out') === '1' || params.get('clear_token') === '1') {
                    sessionStorage.removeItem('pqtv_admin_token');
                    sessionStorage.removeItem('pqtv_watch_token');
                    if (window.location.pathname !== '/login') {
                        history.replaceState(null, '', '/login');
                    }
                } else {
                    const savedAdmin = sessionStorage.getItem('pqtv_admin_token');
                    if (savedAdmin) {
                        enterAdmin(savedAdmin);
                        return;
                    }
                    const savedWatch = sessionStorage.getItem('pqtv_watch_token');
                    if (savedWatch) {
                        enterWatch(savedWatch);
                        return;
                    }
                }
            } catch {}

            // Show APK download link on login screen if an APK release is published
            fetch('/api/app/version', { credentials: 'same-origin' })
                .then(r => r.json())
                .then(d => {
                    if (d && d.hasApk && d.latest) {
                        const strip = document.getElementById('apk-download-strip');
                        const lbl = document.getElementById('apk-download-label');
                        if (lbl) lbl.textContent = 'Скачать APK для Android TV (v' + d.latest.versionName + ')';
                        if (strip) strip.classList.remove('hidden');
                    }
                })
                .catch(() => {});

            if (btnGoogle) {
                btnGoogle.addEventListener('click', async () => {
                    if (msgBox) { msgBox.textContent = ''; msgBox.classList.add('hidden'); }
                    if (newTabHint) newTabHint.classList.add('hidden');
                    btnGoogle.disabled = true;
                    try {
                        if (!window.PQTVFirebase || typeof window.PQTVFirebase.signInUnified !== 'function') {
                            throw new Error('Firebase SDK не загружен');
                        }
                        const res = await window.PQTVFirebase.signInUnified();
                        if (res.pendingApproval) {
                            showMsg('Аккаунт зарегистрирован. Ожидайте активации администратором.', true);
                            return;
                        }
                        if (!res.ok) {
                            throw new Error(res.error || 'Ошибка входа через Google');
                        }
                        if (res.watchToken) {
                            try { sessionStorage.setItem('pqtv_watch_token', res.watchToken); } catch {}
                        }
                        if (res.role === 'admin' && res.adminToken) {
                            enterAdmin(res.adminToken);
                        } else {
                            enterWatch(res.watchToken || '');
                        }
                    } catch (e) {
                        const code = e && e.code ? String(e.code) : '';
                        let msg = (e && e.message) ? e.message : 'Ошибка авторизации';
                        if (code === 'auth/popup-blocked') {
                            msg = 'Браузер заблокировал всплывающее окно Google. Откройте страницу входа в новой вкладке.';
                            if (newTabHint) newTabHint.classList.remove('hidden');
                        } else if (code === 'auth/popup-closed-by-user') {
                            msg = 'Окно входа Google было закрыто.';
                        } else if (code === 'auth/unauthorized-domain') {
                            msg = 'Домен не авторизован в Firebase Auth (' + window.location.hostname + ').';
                        }
                        showMsg(msg, false);
                    } finally {
                        btnGoogle.disabled = false;
                    }
                });
            }
        })();
    </script>
</body>
</html>
