<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PQTV</title>
    <meta name="application-name" content="PQTV">
    <meta name="apple-mobile-web-app-title" content="PQTV">
    <meta property="og:title" content="PQTV">
    <link rel="stylesheet" href="/assets/css/style.css?v=<%= assetVersion('/assets/css/style.css') %>">
    <script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.13/dist/hls.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/mpegts.js@1.7.3/dist/mpegts.js"></script>
</head>
<body>
    <div class="app-shell">
        <div class="top-bar">
            <div class="brand">
                <div class="brand-mark"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 180">
  <defs>
    <linearGradient id="LGRAD4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4A0E4E"/>
      <stop offset="25%" stop-color="#673AB7"/>
      <stop offset="55%" stop-color="#311B92"/>
      <stop offset="80%" stop-color="#1A237E"/>
      <stop offset="100%" stop-color="#00BCD4"/>
    </linearGradient>
  </defs>
  <rect width="320" height="180" rx="20" fill="url(#LGRAD4)"/>
  <g stroke="#FFFFFF" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <rect x="30" y="35" width="260" height="110" rx="12" stroke-width="7"/>
    <line x1="145" y1="12" x2="160" y2="35" stroke-width="3"/>
    <circle cx="144" cy="10" r="2.5" fill="#FFFFFF" stroke="none"/>
    <line x1="175" y1="12" x2="160" y2="35" stroke-width="3"/>
    <circle cx="176" cy="10" r="2.5" fill="#FFFFFF" stroke="none"/>
    <line x1="130" y1="158" x2="190" y2="158" stroke-width="6"/>
    <g stroke-width="6">
      <path d="M83,102 L83,64 L103,64 Q117,64 117,75 Q117,86 103,86 L83,86"/>
      <ellipse cx="140" cy="83" rx="18" ry="19"/>
      <line x1="148" y1="95" x2="158" y2="105"/>
      <line x1="163" y1="64" x2="197" y2="64"/>
      <line x1="180" y1="64" x2="180" y2="102"/>
      <path d="M202,64 L219,102 L236,64"/>
    </g>
  </g>
</svg></div>
                <h1>PQ<span>TV</span></h1>
            </div>
            <div style="display:flex; align-items:center; gap:10px;">
                <div class="streaming-mode-control">
                    <label for="streaming-mode-select">Поток</label>
                    <select id="streaming-mode-select" aria-label="Режим передачи видеопотока">
                        <option value="auto_proxy_first">Авто: сначала proxy</option>
                        <option value="auto_direct_first">Авто: напрямую</option>
                        <option value="proxy_only">Только proxy</option>
                        <option value="direct_only">Только напрямую</option>
                    </select>
                    <label class="streaming-https-toggle" title="Пробовать https:// перед http:// при воспроизведении">
                        <input type="checkbox" id="streaming-https-toggle" checked>
                        <span>HTTPS</span>
                    </label>
                    <button type="button" id="btn-open-streaming-settings" class="streaming-gear-btn" title="Тонкая настройка буферизации, воркеров, протоколов и прокси">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/>
                            <line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/>
                            <line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/>
                            <line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/>
                        </svg>
                    </button>
                </div>
                <button type="button" id="btn-admin-alerts" class="logout-link" style="background:transparent; cursor:pointer;" title="Предупреждения о недоступных каналах у пользователей">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                        <line x1="12" y1="9" x2="12" y2="13"/>
                        <line x1="12" y1="17" x2="12.01" y2="17"/>
                    </svg>
                    Предупреждения
                    <span id="admin-alerts-badge" class="alerts-badge hidden">0</span>
                </button>
                <a href="/watch" class="logout-link" title="Открыть просмотр ТВ">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="7" width="20" height="15" rx="2"/><polyline points="17 2 12 7 7 2"/>
                    </svg>
                    Смотреть ТВ
                </a>
                <button type="button" id="btn-admin-password" class="logout-link" style="background:transparent; cursor:pointer;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    Пароль
                </button>
                <a href="/logout" id="btn-admin-logout" class="logout-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                    Выход
                </a>
            </div>
        </div>

        <div class="app-layout">
            <div class="col-left">
                <div class="side-nav" aria-label="Основная навигация">
                    <div class="nav-section">
                        <div class="nav-section-label">Каталог и индекс</div>
                        <button id="nav-btn-catalog" class="nav-item active" data-screen="catalog">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                        </svg>
                        Каталог каналов
                    </button>
                        <button id="nav-btn-sources" class="nav-item" data-screen="sources">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                        </svg>
                        Источники
                    </button>
                        <button id="nav-btn-parser" class="nav-item" data-screen="parser">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"/>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                        </svg>
                        Парсинг каналов
                    </button>
                        <button id="nav-btn-health" class="nav-item" data-screen="health">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                        </svg>
                        <span>Контроль каналов</span>
                        <span id="nav-health-badge" class="alerts-badge hidden">0</span>
                    </button>
                        <button id="nav-btn-epg" class="nav-item" data-screen="epg">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                            <line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/>
                            <line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                        Телепрограмма
                    </button>
                    </div>
                    <div class="nav-section">
                        <div class="nav-section-label">Плейлисты</div>
                        <button id="nav-btn-editor" class="nav-item" data-screen="editor">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="8" y1="6" x2="21" y2="6"/>
                            <line x1="8" y1="12" x2="21" y2="12"/>
                            <line x1="8" y1="18" x2="21" y2="18"/>
                            <line x1="3" y1="6" x2="3.01" y2="6"/>
                            <line x1="3" y1="12" x2="3.01" y2="12"/>
                            <line x1="3" y1="18" x2="3.01" y2="18"/>
                        </svg>
                        Плейлисты
                    </button>
                    </div>
                    <div class="nav-section">
                        <div class="nav-section-label">Управление</div>
                        <button id="nav-btn-users" class="nav-item" data-screen="users">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                        Пользователи
                    </button>
                    </div>
                    <div class="nav-section">
                        <div class="nav-section-label">Настройки</div>
                        <button id="nav-btn-settings" class="nav-item" data-screen="settings">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                        </svg>
                        Настройки
                    </button>
                    </div>
                </div>

                <div class="sidebar-head">
                    <span>Мои плейлисты</span>
                    <div style="display:flex; align-items:center; gap:4px;">
                        <button id="btn-open-backups" class="btn-icon" title="Резервные копии и журнал целостности">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="9"/>
                                <polyline points="12 7 12 12 15 14"/>
                            </svg>
                        </button>
                        <button id="btn-add-playlist" class="btn-icon" title="Создать плейлист">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"/>
                                <line x1="5" y1="12" x2="19" y2="12"/>
                            </svg>
                        </button>
                    </div>
                </div>
                <ul id="playlist-list" class="nav-list"></ul>
            </div>

            <div class="col-center">
                <div id="screen-editor" class="hidden">
                    <div class="col-header">
                        <h2 id="current-playlist-title">Выберите плейлист</h2>
                        <div class="header-actions">
                            <button id="btn-delete-playlist" type="button" class="btn btn-danger hidden" title="Удалить текущий плейлист">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"/>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                </svg>
                                Удалить плейлист
                            </button>
                            <button id="btn-check-all" class="btn btn-secondary hidden">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                                </svg>
                                Проверить всё
                            </button>
                            <button id="btn-open-categories-global" type="button" class="btn btn-secondary">Категории</button>
                            <button id="btn-add-channel" class="btn btn-primary hidden">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"/>
                                    <line x1="5" y1="12" x2="19" y2="12"/>
                                </svg>
                                Добавить канал
                            </button>
                        </div>
                    </div>

                    <div id="direct-link-box" class="direct-link hidden">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                        </svg>
                        <span>Прямая ссылка:</span>
                        <a id="direct-link-url" href="#" target="_blank"></a>
                    </div>

                    <div id="channels-container">
                        <p class="placeholder-text">Выберите плейлист слева<br>или откройте «Парсинг каналов»</p>
                    </div>
                </div>

                <div id="screen-parser" class="hidden">
                    <div class="col-header">
                        <h2>Индекс источников и поиск каналов</h2>
                    </div>

                    <p style="color:var(--muted); font-size:12.5px; margin-bottom:12px;">
                        Поиск выполняется по индексу включённых источников. Индекс и его ревизия синхронизируются с Firestore; локальные файлы используются только как кеш.
                    </p>
                    <div class="search-bar">
                        <input type="text" id="parse-search-input" placeholder="Введите название канала...">
                        <button id="btn-start-parse" class="btn btn-primary">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"/>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                            </svg>
                            Искать и проверить
                        </button>
                    </div>

                    <div class="target-select">
                        <label>Добавлять в плейлист:</label>
                        <select id="parse-target-playlist"></select>
                    </div>

                    <div id="parse-target-info" class="info-box hidden">
                        Контекст: замена для канала <b id="parse-target-channel-name"></b> в плейлисте <b id="parse-target-playlist-name"></b>
                    </div>

                    <div id="parse-progress-box" class="progress-box hidden">
                        <div class="spinner"></div>
                        <div style="flex:1;">
                            <div id="parse-progress-status" style="font-size:13px; font-weight:600; margin-bottom:3px;">Инициализация поиска...</div>
                            <div id="parse-progress-log" style="font-size:12px; color:var(--muted);">Сканирование активных источников...</div>
                        </div>
                    </div>

                    <div id="parse-results-container">
                        <p class="placeholder-text">Введите имя канала и нажмите «Искать и проверить»</p>
                    </div>
                </div>

                <div id="screen-sources" class="hidden">
                    <div class="col-header">
                        <h2>Источники для парсинга</h2>
                        <div style="display:flex; gap:8px;">
                            <button id="btn-refresh-index" class="btn btn-primary">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="23 4 23 10 17 10"/>
                                    <polyline points="1 20 1 14 7 14"/>
                                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
                                </svg>
                                <span id="btn-refresh-text">Обновить индекс</span>
                            </button>
                            <button id="btn-add-source" class="btn btn-primary">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"/>
                                    <line x1="5" y1="12" x2="19" y2="12"/>
                                </svg>
                                Добавить источник
                            </button>
                        </div>
                    </div>
                    <p style="color:var(--muted); font-size:12.5px; margin-bottom:8px;">
                        Индекс формируется из включённых источников, синхронизируется с Firestore и используется для поиска каналов и отслеживания изменений. Серверный индекс на диске — только временный кеш. Автоматическое обновление — раз в 6 часов.
                    </p>
                    <div id="sources-list-container"></div>
                </div>

                <div id="screen-epg" class="hidden">
                    <div class="col-header">
                        <h2>Телепрограмма (EPG)</h2>
                        <button id="btn-add-epg" class="btn btn-primary">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"/>
                                <line x1="5" y1="12" x2="19" y2="12"/>
                            </svg>
                            Добавить ссылку
                        </button>
                    </div>
                    <p style="color:var(--muted); font-size:12.5px; margin-bottom:12px;">Источники телепрограммы в формате XMLTV (.xml / .xml.gz). Ссылки источников используются сервером для загрузки программы и не раздаются зрителям.</p>
                    <div id="epg-list-container"></div>
                </div>

                <div id="screen-users" class="hidden">
                    <div class="col-header">
                        <h2>Пользователи</h2>
                        <button id="btn-add-user" class="btn btn-primary">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"/>
                                <line x1="5" y1="12" x2="19" y2="12"/>
                            </svg>
                            Добавить пользователя
                        </button>
                    </div>
                    <p style="color:var(--muted); font-size:12.5px; margin-bottom:12px;">
                        Пользователи входят по адресу <b style="color:var(--primary-hi);">/watch</b> и видят только те каналы, которые вы им разрешите. Никаких плейлистов и админ-функций.
                    </p>
                    <div id="firebase-users-bar" class="info-box" style="display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:14px;">
                        <div style="font-size:12.5px;">
                            <strong style="color:#fff;">Firebase Firestore:</strong>
                            <span id="fb-status-text" style="color:var(--muted);">Проверка подключения...</span>
                        </div>
                        <div style="display:flex; gap:8px; align-items:center;">
                            <button type="button" id="btn-fb-connect" class="btn btn-secondary" style="padding:7px 12px; font-size:12px;">Войти в Google (Firebase)</button>
                            <button type="button" id="btn-fb-sync" class="btn btn-secondary hidden" style="padding:7px 12px; font-size:12px;">Импортировать локальных в Firestore</button>
                        </div>
                    </div>
                    <div id="users-fb-error" class="error-msg hidden" style="margin-bottom:12px;"></div>
                    <div id="users-list-container"></div>
                    <div id="invites-section" style="margin-top:24px;">
                        <h3 style="font-size:14px; font-weight:700; color:#fff; margin-bottom:10px;">Приглашения по Google Email</h3>
                        <div id="invites-list-container"></div>
                    </div>
                </div>

                <div id="screen-catalog">
                    <div class="catalog-stats" id="catalog-stats">
                        <!-- JS заполнит -->
                    </div>

                    <div class="col-header catalog-page-heading">
