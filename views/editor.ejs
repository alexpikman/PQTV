                    </div>
                    <div class="form-actions">
                        <button type="submit" id="health-replace-submit" class="btn btn-primary" style="flex:1;">Сохранить и проверить</button>
                        <button type="button" id="health-probe-candidates" class="btn btn-secondary">Найти рабочие в источниках</button>
                    </div>
                </form>

                <div style="margin-top:18px; border-top:1px solid var(--border); padding-top:14px;">
                    <h4 style="font-size:13px; color:#fff; margin-bottom:10px;">Альтернативные потоки из каталога и источников</h4>
                    <div id="health-candidates-list" style="display:flex; flex-direction:column; gap:8px;">
                        <p class="placeholder-text" style="margin:14px 0;">Нажмите «Найти рабочие в источниках» для автопоиска и проверки</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BACKUPS & LIFECYCLE AUDIT MODAL -->
    <div id="backups-modal" class="player-modal hidden" style="z-index:12700;">
        <div class="player-backdrop" id="backups-modal-backdrop"></div>
        <div class="player-window" style="max-width:760px; width:100%; max-height:86vh; display:flex; flex-direction:column;">
            <div class="player-head">
                <div class="player-meta">
                    <div class="player-title">Резервные копии и журнал целостности</div>
                    <div class="player-url" id="lifecycle-revision-label">Ревизия базы: —</div>
                </div>
                <div class="player-actions">
                    <button type="button" id="btn-run-reconcile" class="btn btn-secondary" style="padding:6px 12px; font-size:12px;">Синхронизировать каталог</button>
                    <button type="button" id="backups-modal-close" class="btn-icon" title="Закрыть">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"/>
                            <line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                </div>
            </div>
            <div style="padding:18px 20px; overflow-y:auto; flex:1; display:flex; flex-direction:column; gap:18px;">
                <div>
                    <h4 style="font-size:13px; color:#fff; margin-bottom:10px;">Резервные копии плейлистов (.bak)</h4>
                    <div id="backups-list-container"><p class="placeholder-text">Загрузка...</p></div>
                </div>
                <div style="border-top:1px solid var(--border); padding-top:14px;">
                    <h4 style="font-size:13px; color:#fff; margin-bottom:10px;">Журнал операций жизненного цикла</h4>
                    <div id="lifecycle-logs-container"><p class="placeholder-text">Загрузка...</p></div>
                </div>
            </div>
        </div>
    </div>

    <!-- GLOBAL CHANNEL CATEGORIES MODAL -->
    <div id="categories-modal" class="player-modal hidden" style="z-index:12800;">
        <div class="player-backdrop" id="categories-modal-backdrop"></div>
        <div class="player-window category-modal-window">
            <div class="player-head">
                <div class="player-meta"><div class="player-title">Глобальные категории</div></div>
                <div class="player-actions">
                    <button type="button" id="categories-modal-close" class="btn-icon" title="Закрыть">×</button>
                </div>
            </div>
            <div class="category-modal-body">
                <div class="form-group">
                    <label for="category-name-input">Название категории</label>
                    <div class="header-actions">
                        <input type="text" id="category-name-input" maxlength="80" placeholder="Например: Спорт">
                        <button type="button" id="btn-category-add" class="btn btn-primary">Добавить</button>
                    </div>
                </div>
                <div id="categories-list"></div>
            </div>
        </div>
    </div>

    <!-- IN-APP CONFIRM / PROMPT MODAL -->
    <div id="pqtv-dialog-modal" class="player-modal hidden" style="z-index:15000;">
        <div class="player-backdrop" id="pqtv-dialog-backdrop"></div>
        <div class="player-window" style="max-width:420px; width:100%;">
            <div class="player-head">
                <div class="player-meta">
                    <div class="player-title" id="pqtv-dialog-title">Подтверждение</div>
                </div>
            </div>
            <form id="pqtv-dialog-form" style="padding:20px;">
                <p id="pqtv-dialog-msg" style="font-size:13.5px; color:var(--text-dim); line-height:1.5; margin-bottom:14px;"></p>
                <div class="form-group hidden" id="pqtv-dialog-input-wrap">
                    <input type="text" id="pqtv-dialog-input" autocomplete="off">
                </div>
                <div class="form-actions" style="margin-top:14px;">
                    <button type="submit" class="btn btn-primary" id="pqtv-dialog-ok" style="flex:1;">ОК</button>
                    <button type="button" class="btn btn-secondary" id="pqtv-dialog-cancel">Отмена</button>
                </div>
            </form>
        </div>
    </div>

    <div id="pqtv-toast-stack" class="pqtv-toast-stack"></div>

    <script>
        window.CSRF_TOKEN = <%- JSON.stringify(csrfToken) %>;
        window.ADMIN_TOKEN = <%- JSON.stringify(typeof adminToken === 'string' ? adminToken : '') %>;
        try {
            if (window.ADMIN_TOKEN) sessionStorage.setItem('pqtv_admin_token', window.ADMIN_TOKEN);
            if (window.location.pathname !== '/editor') history.replaceState(null, '', '/editor');
        } catch {}
    </script>
    <script src="/assets/js/firebase-users.js?v=<%= assetVersion('/assets/js/firebase-users.js') %>"></script>
    <script src="/assets/js/app.js?v=<%= assetVersion('/assets/js/app.js') %>"></script>
</body>
</html>
