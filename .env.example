# Copy to .env and replace every required placeholder.
PQTV_PORT=3000
POSTGRES_DB=pqtv
POSTGRES_USER=pqtv
POSTGRES_PASSWORD=REPLACE_WITH_64_CHARACTER_HEX_SECRET
PORT=3000
# Режим хранения: local (файлы на сервере в data/ и playlist/) или cloud (Firebase Firestore)
PQTV_STORAGE_MODE=local
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
APK_UPLOAD_TOKEN=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
ADMIN_EMAIL=admin@example.com
# Generate a bcrypt hash with bcryptjs; see docs/DEPLOYMENT_DOCKER.md
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
# Необязательно (только если PQTV_STORAGE_MODE=cloud и используется свой Firebase проект)
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
