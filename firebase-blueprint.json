{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Operational PQTV viewer account record (playlists, status, activity) without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique user identifier or Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "login": {
          "type": "string",
          "description": "Unique viewer login handle.",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_.-]{3,32}$"
        },
        "name": {
          "type": "string",
          "description": "Display name shown in the player and admin list.",
          "minLength": 1,
          "maxLength": 80
        },
        "playlists": {
          "type": "array",
          "description": "List of playlist filenames assigned to this user (max 20)."
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether the user is allowed to watch streams."
        },
        "role": {
          "type": "string",
          "description": "Access role.",
          "enum": ["user", "admin"]
        },
        "lastPing": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last viewer heartbeat."
        },
        "lastUa": {
          "type": "string",
          "description": "Truncated user-agent string from the last session.",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["uid", "login", "name", "playlists", "enabled", "role", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record for a user (email address).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email.",
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Trusted admin role assignment document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Admin Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["uid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "PQTV user profiles managed by admin and synced with viewer sessions."
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII document storing user email, readable only by owner or admin."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Trusted admin role documents checked by Firestore security rules."
    }
  }
}
