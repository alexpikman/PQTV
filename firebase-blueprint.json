{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Operational PQTV viewer account record (playlists, status, activity) without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique user identifier or Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "login": {
          "type": "string",
          "description": "Unique viewer login handle.",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_.-]{3,32}$"
        },
        "name": {
          "type": "string",
          "description": "Display name shown in the player and admin list.",
          "minLength": 1,
          "maxLength": 80
        },
        "playlists": {
          "type": "array",
          "description": "List of playlist filenames assigned to this user (max 50)."
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether the user is allowed to watch streams."
        },
        "role": {
          "type": "string",
          "description": "Access role.",
          "enum": ["user", "admin"]
        },
        "inviteId": {
          "type": "string",
          "description": "Optional SHA-256 lowercase email invite ID used to claim pre-assigned playlists.",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "lastPing": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last viewer heartbeat."
        },
        "lastUa": {
          "type": "string",
          "description": "Truncated user-agent string from the last session.",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["uid", "login", "name", "playlists", "enabled", "role", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record for a user (email address).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email.",
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "UserCredentials": {
      "title": "UserCredentials",
      "description": "Admin-only bcrypt password hash storage for local TV viewer accounts.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "User ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "passwordHash": {
          "type": "string",
          "description": "Bcrypt password hash.",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "passwordHash", "createdAt", "updatedAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Trusted admin role assignment document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Admin Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["uid", "createdAt"]
    },
    "Invite": {
      "title": "Invite",
      "description": "Cloud invitation for a Google account with pre-assigned playlists (no PII in document).",
      "type": "object",
      "properties": {
        "emailHash": {
          "type": "string",
          "description": "SHA-256 hex digest of normalized lowercase invited email.",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "name": {
          "type": "string",
          "description": "Display name assigned by admin.",
          "minLength": 1,
          "maxLength": 80
        },
        "playlists": {
          "type": "array",
          "description": "Assigned playlist filenames (max 50)."
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether the invite immediately grants viewing access."
        },
        "invitedByUid": {
          "type": "string",
          "description": "Admin UID who created the invite.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "claimedUid": {
          "type": "string",
          "description": "Firebase UID of the user who claimed this invite.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["emailHash", "name", "playlists", "enabled", "invitedByUid", "createdAt", "updatedAt"]
    },
    "InvitePrivateInfo": {
      "title": "InvitePrivateInfo",
      "description": "Isolated PII record holding the invited Google email.",
      "type": "object",
      "properties": {
        "emailHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["emailHash", "email", "createdAt", "updatedAt"]
    },
    "ChannelAlert": {
      "title": "ChannelAlert",
      "description": "Admin warning recorded when a viewer opens PQTV and encounters unavailable channels.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userLogin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "totalChannels": {
          "type": "integer"
        },
        "unavailableCount": {
          "type": "integer"
        },
        "items": {
          "type": "array"
        },
        "resolved": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "userLogin", "userName", "totalChannels", "unavailableCount", "items", "resolved", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Global channel category name used by playlist group and viewer grouping.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "createdByUid", "updatedByUid", "createdAt", "updatedAt"]
    },
    "CloudManifest": {
      "title": "CloudManifest",
      "description": "Master index of persisted playlists, sources, source indexes, EPGs, catalog chunks, and local users.",
      "type": "object",
      "properties": {
        "docId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "playlists": {
          "type": "array",
          "description": "List of playlist IDs (max 100)."
        },
        "sourceIds": {
          "type": "array",
          "description": "List of source IDs (max 100)."
        },
        "sourceIndexIds": {
          "type": "array",
          "description": "List of indexed source IDs (max 100)."
        },
        "epgIds": {
          "type": "array",
          "description": "List of EPG source IDs (max 50)."
        },
        "localUserIds": {
          "type": "array",
          "description": "List of local user IDs whose credentials are stored in Firestore (max 500)."
        },
        "catalogChannelChunks": {
          "type": "integer"
        },
        "catalogStreamChunks": {
          "type": "integer"
        },
        "revision": {
          "type": "integer",
          "description": "Monotonic server state revision counter for stale snapshot protection."
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["docId", "playlists", "sourceIds", "sourceIndexIds", "epgIds", "localUserIds", "catalogChannelChunks", "catalogStreamChunks", "updatedByUid", "createdAt", "updatedAt"]
    },
    "PlaylistMeta": {
      "title": "PlaylistMeta",
      "description": "Metadata document for an M3U playlist stored in Firestore.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "channelCount": {
          "type": "integer"
        },
        "chunkCount": {
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "channelCount", "chunkCount", "createdAt", "updatedAt"]
    },
    "PlaylistChunk": {
      "title": "PlaylistChunk",
      "description": "Chunk of up to 200 channels belonging to a playlist.",
      "type": "object",
      "properties": {
        "playlistId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,63}$"
        },
        "index": {
          "type": "integer"
        },
        "items": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["playlistId", "index", "items", "createdAt", "updatedAt"]
    },
    "StreamSource": {
      "title": "StreamSource",
      "description": "External playlist/parser source definition with optional custom request headers, timeout, and TLS override.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "enabled": {
          "type": "boolean"
        },
        "userAgent": {
          "type": "string",
          "maxLength": 400
        },
        "referer": {
          "type": "string",
          "maxLength": 500
        },
        "origin": {
          "type": "string",
          "maxLength": 300
        },
        "timeoutSec": {
          "type": "integer"
        },
        "ignoreTlsErrors": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "type", "url", "enabled", "createdAt", "updatedAt"]
    },
    "SourceIndexMeta": {
      "title": "SourceIndexMeta",
      "description": "Metadata and last-updated timestamp for a cached source index.",
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "count": {
          "type": "integer"
        },
        "chunkCount": {
          "type": "integer"
        },
        "indexedAt": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["sourceId", "count", "chunkCount", "indexedAt", "createdAt", "updatedAt"]
    },
    "SourceIndexChunk": {
      "title": "SourceIndexChunk",
      "description": "Chunk of up to 250 indexed channels for a parser source.",
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "index": {
          "type": "integer"
        },
        "items": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["sourceId", "index", "items", "createdAt", "updatedAt"]
    },
    "EpgSourceDoc": {
      "title": "EpgSourceDoc",
      "description": "XMLTV EPG source configuration.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "enabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "url", "enabled", "createdAt", "updatedAt"]
    },
    "CatalogSummary": {
      "title": "CatalogSummary",
      "description": "Catalog metadata, counters, sources (id, optional stringId, name, type, url, enabled, created_at, last_run, last_status, total_found), and chunk counts.",
      "type": "object",
      "properties": {
        "docId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "nextChannelId": {
          "type": "integer"
        },
        "nextStreamId": {
          "type": "integer"
        },
        "nextSourceId": {
          "type": "integer"
        },
        "channelChunkCount": {
          "type": "integer"
        },
        "streamChunkCount": {
          "type": "integer"
        },
        "sources": {
          "type": "array",
          "description": "List of up to 100 CatalogSource objects with id, optional stringId, name, type, url, enabled, created_at, and optional run stats."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["docId", "nextChannelId", "nextStreamId", "nextSourceId", "channelChunkCount", "streamChunkCount", "sources", "createdAt", "updatedAt"]
    },
    "CatalogChunk": {
      "title": "CatalogChunk",
      "description": "Chunk of up to 200 catalog channel entities.",
      "type": "object",
      "properties": {
        "index": {
          "type": "integer"
        },
        "items": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["index", "items", "createdAt", "updatedAt"]
    },
    "CatalogStreamChunk": {
      "title": "CatalogStreamChunk",
      "description": "Chunk of up to 250 catalog stream entities.",
      "type": "object",
      "properties": {
        "index": {
          "type": "integer"
        },
        "items": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["index", "items", "createdAt", "updatedAt"]
    },
    "StreamingSetting": {
      "title": "StreamingSetting",
      "description": "Global stream delivery, proxy pooling, HLS/MPEG-TS buffering, worker, retry, and player delay configuration readable by verified viewers and admins.",
      "type": "object",
      "properties": {
        "settingId": {
          "type": "string",
          "enum": ["streaming"]
        },
        "preset": {
          "type": "string",
          "enum": ["vlc_smooth", "balanced", "low_latency", "custom"]
        },
        "mode": {
          "type": "string",
          "enum": ["auto_proxy_first", "auto_direct_first", "proxy_only", "direct_only"]
        },
        "preferDirectOnTv": { "type": "boolean" },
        "tryHttpsUpgrade": { "type": "boolean" },
        "protocolHint": {
          "type": "string",
          "enum": ["auto", "hls", "mpegts", "native"]
        },
        "proxyUserAgent": {
          "type": "string",
          "maxLength": 240
        },
        "proxyFollowRedirects": { "type": "integer" },
        "proxyTimeoutSec": { "type": "integer" },
        "proxyKeepAlive": { "type": "boolean" },
        "proxyMaxSockets": { "type": "integer" },
        "proxyBufferKb": { "type": "integer" },
        "proxyRetryCount": { "type": "integer" },
        "hlsUseWorkers": { "type": "boolean" },
        "hlsLowLatency": { "type": "boolean" },
        "hlsLiveSyncDurationCount": { "type": "integer" },
        "hlsMaxBufferLengthSec": { "type": "integer" },
        "hlsMaxMaxBufferLengthSec": { "type": "integer" },
        "hlsBackBufferLengthSec": { "type": "integer" },
        "hlsStartFragPrefetch": { "type": "boolean" },
        "hlsManifestTimeoutSec": { "type": "integer" },
        "hlsManifestMaxRetry": { "type": "integer" },
        "hlsFragTimeoutSec": { "type": "integer" },
        "hlsFragMaxRetry": { "type": "integer" },
        "hlsMaxBufferHoleMs": { "type": "integer" },
        "mpegtsUseWorker": { "type": "boolean" },
        "mpegtsStashBuffer": { "type": "boolean" },
        "mpegtsStashSizeKb": { "type": "integer" },
        "mpegtsLiveLatencyChasing": { "type": "boolean" },
        "mpegtsMaxLatencySec": { "type": "number" },
        "mpegtsMinRemainSec": { "type": "number" },
        "attemptTimeoutSec": { "type": "integer" },
        "previewEnabled": { "type": "boolean" },
        "previewDebounceMs": { "type": "integer" },
        "previewResumeDelayMs": { "type": "integer" },
        "codecCheckDelaySec": { "type": "integer" },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "settingId", "preset", "mode", "preferDirectOnTv", "tryHttpsUpgrade",
        "protocolHint", "proxyUserAgent", "proxyFollowRedirects", "proxyTimeoutSec",
        "proxyKeepAlive", "proxyMaxSockets", "proxyBufferKb", "proxyRetryCount",
        "hlsUseWorkers", "hlsLowLatency", "hlsLiveSyncDurationCount", "hlsMaxBufferLengthSec",
        "hlsMaxMaxBufferLengthSec", "hlsBackBufferLengthSec", "hlsStartFragPrefetch",
        "hlsManifestTimeoutSec", "hlsManifestMaxRetry", "hlsFragTimeoutSec", "hlsFragMaxRetry",
        "hlsMaxBufferHoleMs", "mpegtsUseWorker", "mpegtsStashBuffer", "mpegtsStashSizeKb",
        "mpegtsLiveLatencyChasing", "mpegtsMaxLatencySec", "mpegtsMinRemainSec",
        "attemptTimeoutSec", "previewEnabled", "previewDebounceMs", "previewResumeDelayMs",
        "codecCheckDelaySec", "createdAt", "updatedAt"
      ]
    },
    "UiSetting": {
      "title": "UiSetting",
      "description": "Global viewer player watermark and UI display settings readable by verified viewers and admins.",
      "type": "object",
      "properties": {
        "settingId": {
          "type": "string",
          "enum": ["ui"]
        },
        "logoEnabled": {
          "type": "boolean"
        },
        "logoOpacity": {
          "type": "integer"
        },
        "logoPulseEnabled": {
          "type": "boolean"
        },
        "logoPulseSpeedSec": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["settingId", "logoEnabled", "logoOpacity", "logoPulseEnabled", "logoPulseSpeedSec", "createdAt", "updatedAt"]
    },
    "ApkSetting": {
      "title": "ApkSetting",
      "description": "Global Android TV APK versioning high-water mark, blocking policy for outdated APKs, and release metadata persisted across server restarts.",
      "type": "object",
      "properties": {
        "settingId": {
          "type": "string",
          "enum": ["apk"]
        },
        "lastVersionCode": {
          "type": "integer"
        },
        "lastVersionName": {
          "type": "string",
          "maxLength": 32
        },
        "minSupportedVersionCode": {
          "type": "integer"
        },
        "blockedVersionCodes": {
          "type": "array",
          "description": "Explicitly blocked integer versionCodes (max 100)."
        },
        "blockMode": {
          "type": "string",
          "enum": ["hard", "soft"]
        },
        "blockMessage": {
          "type": "string",
          "maxLength": 300
        },
        "releases": {
          "type": "array",
          "description": "Recent APK releases metadata including externalApkUrl and blocked flags (max 15)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "settingId", "lastVersionCode", "lastVersionName",
        "minSupportedVersionCode", "blockedVersionCodes",
        "blockMode", "blockMessage", "releases",
        "createdAt", "updatedAt"
      ]
    },
    "AdminSetting": {
      "title": "AdminSetting",
      "description": "Admin-only application settings (GitHub repo/branch metadata, admin password hash override, etc.).",
      "type": "object",
      "properties": {
        "settingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "githubRepo": {
          "type": "string",
          "maxLength": 200
        },
        "githubBranch": {
          "type": "string",
          "maxLength": 80
        },
        "adminPasswordHash": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["settingId", "createdAt", "updatedAt"]
    },
    "ChannelHealthDoc": {
      "title": "ChannelHealthDoc",
      "description": "Admin-only unified channel health diagnostics, viewer exclusion state, and verified resolve status.",
      "type": "object",
      "properties": {
        "docId": {
          "type": "string",
          "enum": ["main"]
        },
        "diagnostics": {
          "type": "array",
          "description": "Latest stream diagnostics list (max 400)."
        },
        "issues": {
          "type": "array",
          "description": "Per-channel viewer error & resolve verification state list (max 250)."
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["docId", "diagnostics", "issues", "updatedByUid", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "PQTV user profiles managed by admin and synced with viewer sessions."
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII document storing user email, readable only by owner or admin."
    },
    "/users/{userId}/private/credentials": {
      "schema": { "$ref": "#/entities/UserCredentials" },
      "description": "Admin-only password hashes for local login+password accounts."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Trusted admin role documents checked by Firestore security rules."
    },
    "/invites/{inviteId}": {
      "schema": { "$ref": "#/entities/Invite" },
      "description": "Cloud Google email invites with pre-assigned playlists (keyed by email SHA-256)."
    },
    "/invites/{inviteId}/private/info": {
      "schema": { "$ref": "#/entities/InvitePrivateInfo" },
      "description": "Isolated PII document containing the invited email address."
    },
    "/channel_alerts/{alertId}": {
      "schema": { "$ref": "#/entities/ChannelAlert" },
      "description": "Admin alerts showing users who opened the app and discovered unavailable channels."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Global category dictionary. Admins manage category names; verified viewers can read them for channel grouping."
    },
    "/cloud_meta/{docId}": {
      "schema": { "$ref": "#/entities/CloudManifest" },
      "description": "Master cloud index manifest (admin-only)."
    },
    "/playlists/{playlistId}": {
      "schema": { "$ref": "#/entities/PlaylistMeta" },
      "description": "M3U playlist metadata; readable by admins and viewers assigned that playlist."
    },
    "/playlists/{playlistId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/PlaylistChunk" },
      "description": "Chunked channel rows for each playlist; readable by admins and viewers assigned that playlist."
    },
    "/sources/{sourceId}": {
      "schema": { "$ref": "#/entities/StreamSource" },
      "description": "Configured parser sources (admin-only)."
    },
    "/source_index/{sourceId}": {
      "schema": { "$ref": "#/entities/SourceIndexMeta" },
      "description": "Metadata and index timestamp for cached source indexes (admin-only)."
    },
    "/source_index/{sourceId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/SourceIndexChunk" },
      "description": "Chunked indexed channels for cached parser sources (admin-only)."
    },
    "/epg_sources/{epgId}": {
      "schema": { "$ref": "#/entities/EpgSourceDoc" },
      "description": "XMLTV EPG source URLs (admin-only)."
    },
    "/catalog_summary/{docId}": {
      "schema": { "$ref": "#/entities/CatalogSummary" },
      "description": "Catalog metadata, counters, and source list (admin-only)."
    },
    "/catalog_chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/CatalogChunk" },
      "description": "Chunked catalog channels (admin-only)."
    },
    "/catalog_stream_chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/CatalogStreamChunk" },
      "description": "Chunked catalog streams and check statuses (admin-only)."
    },
    "/app_settings/{settingId}": {
      "schema": { "$ref": "#/entities/StreamingSetting" },
      "description": "Global application settings (streaming, ui, apk); readable by verified viewers and admins."
    },
    "/admin_settings/{settingId}": {
      "schema": { "$ref": "#/entities/AdminSetting" },
      "description": "Admin-only application settings (GitHub repo/branch, admin password hash)."
    },
    "/channel_health/{docId}": {
      "schema": { "$ref": "#/entities/ChannelHealthDoc" },
      "description": "Admin-only unified channel health diagnostics & resolve verification state."
    }
  }
}
