rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ===== GLOBAL PRIMITIVES =====
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPlaylistId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,63}$');
    }

    function isValidEmailHash(hash) {
      return hash is string && hash.size() == 64 && hash.matches('^[a-f0-9]{64}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedEmail()
        && request.auth.token.email in ['alexpqtr@gmail.com', 'alex.pikman@gmail.com'];
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isVerifiedEmail() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isInvitedEmailOwner(inviteId) {
      return isVerifiedEmail()
        && isValidEmailHash(inviteId)
        && exists(/databases/$(database)/documents/invites/$(inviteId)/private/info)
        && get(/databases/$(database)/documents/invites/$(inviteId)/private/info).data.email == request.auth.token.email.lower();
    }

    function isViewerWithPlaylist(playlistId) {
      return isVerifiedEmail()
        && isValidPlaylistId(playlistId)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enabled == true
        && playlistId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.playlists;
    }

    // ===== VALIDATION BLUEPRINTS =====
    function isValidPlaylistsList(list) {
      return list is list
        && list.size() <= 50
        && (list.size() == 0 || (list[0] is string && list[0].size() >= 1 && list[0].size() <= 64));
    }

    function isValidIdList(list, maxLen) {
      return list is list
        && list.size() <= maxLen
        && (list.size() == 0 || (list[0] is string && list[0].size() >= 1 && list[0].size() <= 128));
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'login', 'name', 'playlists', 'enabled', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'login', 'name', 'playlists', 'enabled', 'role', 'inviteId', 'lastPing', 'lastUa', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.login is string && data.login.size() >= 3 && data.login.size() <= 32 && data.login.matches('^[a-zA-Z0-9_.-]{3,32}$')
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && isValidPlaylistsList(data.playlists)
        && data.enabled is bool
        && data.role is string && data.role in ['user', 'admin']
        && (!('inviteId' in data) || isValidEmailHash(data.inviteId))
        && (!('lastPing' in data) || data.lastPing is timestamp)
        && (!('lastUa' in data) || (data.lastUa is string && data.lastUa.size() <= 120))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserCredentials(data) {
      return data.keys().hasAll(['uid', 'passwordHash', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'passwordHash', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.passwordHash is string && data.passwordHash.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRole(data) {
      return data.keys().hasAll(['uid', 'createdAt'])
        && data.keys().hasOnly(['uid', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.createdAt is timestamp;
    }

    function isValidInvite(data) {
      return data.keys().hasAll(['emailHash', 'name', 'playlists', 'enabled', 'invitedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['emailHash', 'name', 'playlists', 'enabled', 'invitedByUid', 'claimedUid', 'createdAt', 'updatedAt'])
        && isValidEmailHash(data.emailHash)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && isValidPlaylistsList(data.playlists)
        && data.enabled is bool
        && data.invitedByUid is string && data.invitedByUid.size() >= 1 && data.invitedByUid.size() <= 128 && data.invitedByUid.matches('^[a-zA-Z0-9_\\-]+$')
        && (!('claimedUid' in data) || (data.claimedUid is string && data.claimedUid.size() <= 128 && data.claimedUid.matches('^[a-zA-Z0-9_\\-]*$')))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInvitePrivateInfo(data) {
      return data.keys().hasAll(['emailHash', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['emailHash', 'email', 'createdAt', 'updatedAt'])
        && isValidEmailHash(data.emailHash)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAlertItems(items) {
      return items is list
        && items.size() <= 50
        && (items.size() == 0 || (
          items[0] is map
          && items[0].keys().hasAll(['name', 'group', 'reason'])
          && items[0].keys().hasOnly(['name', 'group', 'reason'])
          && items[0].name is string && items[0].name.size() >= 1 && items[0].name.size() <= 120
          && items[0].group is string && items[0].group.size() <= 80
          && items[0].reason is string && items[0].reason.size() >= 1 && items[0].reason.size() <= 200
        ));
    }

    function isValidChannelAlert(data) {
      return data.keys().hasAll(['uid', 'userLogin', 'userName', 'totalChannels', 'unavailableCount', 'items', 'resolved', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'userLogin', 'userName', 'totalChannels', 'unavailableCount', 'items', 'resolved', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userLogin is string && data.userLogin.size() >= 1 && data.userLogin.size() <= 64
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80
        && data.totalChannels is int && data.totalChannels >= 0 && data.totalChannels <= 50000
        && data.unavailableCount is int && data.unavailableCount >= 0 && data.unavailableCount <= 50000
        && isValidAlertItems(data.items)
        && data.resolved is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'createdByUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'createdByUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128
        && data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidCloudManifest(data) {
      return data.keys().hasAll(['docId', 'playlists', 'sourceIds', 'sourceIndexIds', 'epgIds', 'localUserIds', 'catalogChannelChunks', 'catalogStreamChunks', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['docId', 'playlists', 'sourceIds', 'sourceIndexIds', 'epgIds', 'localUserIds', 'catalogChannelChunks', 'catalogStreamChunks', 'revision', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.docId is string && data.docId == 'manifest'
        && isValidIdList(data.playlists, 100)
        && isValidIdList(data.sourceIds, 100)
        && isValidIdList(data.sourceIndexIds, 100)
        && isValidIdList(data.epgIds, 50)
        && isValidIdList(data.localUserIds, 500)
        && data.catalogChannelChunks is int && data.catalogChannelChunks >= 0 && data.catalogChannelChunks <= 500
        && data.catalogStreamChunks is int && data.catalogStreamChunks >= 0 && data.catalogStreamChunks <= 500
        && (!('revision' in data) || (data.revision is int && data.revision >= 0))
        && data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlaylistMeta(data) {
      return data.keys().hasAll(['id', 'name', 'channelCount', 'chunkCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'channelCount', 'chunkCount', 'createdAt', 'updatedAt'])
        && isValidPlaylistId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 64
        && data.channelCount is int && data.channelCount >= 0 && data.channelCount <= 50000
        && data.chunkCount is int && data.chunkCount >= 0 && data.chunkCount <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlaylistChunkItems(items) {
      return items is list
        && items.size() <= 200
        && (items.size() == 0 || (
          items[0] is map
          && items[0].keys().hasAll(['name', 'group', 'logo', 'url', 'tvg_id'])
          && items[0].keys().hasOnly(['name', 'group', 'logo', 'url', 'tvg_id', 'paused', 'userAgent', 'referer', 'origin'])
          && items[0].name is string && items[0].name.size() <= 200
          && items[0].group is string && items[0].group.size() <= 120
          && items[0].logo is string && items[0].logo.size() <= 1000
          && items[0].url is string && items[0].url.size() <= 1500
          && items[0].tvg_id is string && items[0].tvg_id.size() <= 160
          && (!('paused' in items[0]) || items[0].paused is bool)
          && (!('userAgent' in items[0]) || (items[0].userAgent is string && items[0].userAgent.size() <= 400))
          && (!('referer' in items[0]) || (items[0].referer is string && items[0].referer.size() <= 500))
          && (!('origin' in items[0]) || (items[0].origin is string && items[0].origin.size() <= 300))
        ));
    }

    function isValidPlaylistChunk(data) {
      return data.keys().hasAll(['playlistId', 'index', 'items', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['playlistId', 'index', 'items', 'createdAt', 'updatedAt'])
        && isValidPlaylistId(data.playlistId)
        && data.index is int && data.index >= 0 && data.index <= 300
        && isValidPlaylistChunkItems(data.items)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStreamSource(data) {
      return data.keys().hasAll(['id', 'name', 'type', 'url', 'enabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'type', 'url', 'enabled', 'userAgent', 'referer', 'origin', 'timeoutSec', 'ignoreTlsErrors', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.type is string && data.type.size() >= 1 && data.type.size() <= 32
        && data.url is string && data.url.size() >= 1 && data.url.size() <= 1000
        && data.enabled is bool
        && (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 400))
        && (!('referer' in data) || (data.referer is string && data.referer.size() <= 500))
        && (!('origin' in data) || (data.origin is string && data.origin.size() <= 300))
        && (!('timeoutSec' in data) || (data.timeoutSec is int && data.timeoutSec >= 3 && data.timeoutSec <= 60))
        && (!('ignoreTlsErrors' in data) || data.ignoreTlsErrors is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSourceIndexMeta(data) {
      return data.keys().hasAll(['sourceId', 'count', 'chunkCount', 'indexedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['sourceId', 'count', 'chunkCount', 'indexedAt', 'createdAt', 'updatedAt'])
        && isValidId(data.sourceId)
        && data.count is int && data.count >= 0 && data.count <= 100000
        && data.chunkCount is int && data.chunkCount >= 0 && data.chunkCount <= 500
        && data.indexedAt is int && data.indexedAt >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSourceIndexChunk(data) {
      return data.keys().hasAll(['sourceId', 'index', 'items', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['sourceId', 'index', 'items', 'createdAt', 'updatedAt'])
        && isValidId(data.sourceId)
        && data.index is int && data.index >= 0 && data.index <= 500
        && itemsIsValidIndexedList(data.items)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function itemsIsValidIndexedList(items) {
      return items is list
        && items.size() <= 250
        && (items.size() == 0 || (
          items[0] is map
          && items[0].keys().hasAll(['name', 'url', 'logo', 'group', 'tvg_id'])
          && items[0].keys().hasOnly(['name', 'url', 'logo', 'group', 'tvg_id', 'userAgent', 'referer', 'origin'])
          && items[0].name is string && items[0].name.size() <= 200
          && items[0].url is string && items[0].url.size() <= 1500
          && items[0].logo is string && items[0].logo.size() <= 1000
          && items[0].group is string && items[0].group.size() <= 120
          && items[0].tvg_id is string && items[0].tvg_id.size() <= 160
          && (!('userAgent' in items[0]) || (items[0].userAgent is string && items[0].userAgent.size() <= 400))
          && (!('referer' in items[0]) || (items[0].referer is string && items[0].referer.size() <= 500))
          && (!('origin' in items[0]) || (items[0].origin is string && items[0].origin.size() <= 300))
        ));
    }

    function isValidEpgSourceDoc(data) {
      return data.keys().hasAll(['id', 'name', 'url', 'enabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'url', 'enabled', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.url is string && data.url.size() >= 1 && data.url.size() <= 1000
        && data.enabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCatalogSourcesList(sources) {
      return sources is list
        && sources.size() <= 100
        && (sources.size() == 0 || (
          sources[0] is map
          && sources[0].keys().hasAll(['id', 'name', 'type', 'url', 'enabled', 'created_at'])
          && sources[0].keys().hasOnly(['id', 'name', 'type', 'url', 'enabled', 'created_at', 'last_run', 'last_status', 'total_found'])
          && sources[0].id is int
          && sources[0].name is string && sources[0].name.size() <= 120
          && sources[0].type is string && sources[0].type.size() <= 32
          && sources[0].url is string && sources[0].url.size() <= 1000
          && sources[0].enabled is int
        ));
    }

    function isValidCatalogSummary(data) {
      return data.keys().hasAll(['docId', 'nextChannelId', 'nextStreamId', 'nextSourceId', 'channelChunkCount', 'streamChunkCount', 'sources', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['docId', 'nextChannelId', 'nextStreamId', 'nextSourceId', 'channelChunkCount', 'streamChunkCount', 'sources', 'createdAt', 'updatedAt'])
        && data.docId is string && data.docId == 'main'
        && data.nextChannelId is int && data.nextChannelId >= 1
        && data.nextStreamId is int && data.nextStreamId >= 1
        && data.nextSourceId is int && data.nextSourceId >= 1
        && data.channelChunkCount is int && data.channelChunkCount >= 0 && data.channelChunkCount <= 500
        && data.streamChunkCount is int && data.streamChunkCount >= 0 && data.streamChunkCount <= 500
        && isValidCatalogSourcesList(data.sources)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCatalogChannelItems(items) {
      return items is list
        && items.size() <= 200
        && (items.size() == 0 || (
          items[0] is map
          && items[0].keys().hasAll(['id', 'code', 'name', 'logo', 'tvg_id', 'in_my_pl', 'used_in', 'alt_names', 'created_at', 'updated_at'])
          && items[0].keys().hasOnly(['id', 'code', 'name', 'logo', 'tvg_id', 'in_my_pl', 'used_in', 'alt_names', 'created_at', 'updated_at'])
          && items[0].id is int
          && items[0].code is string && items[0].code.size() <= 32
          && items[0].name is string && items[0].name.size() <= 200
          && items[0].logo is string && items[0].logo.size() <= 1000
          && items[0].tvg_id is string && items[0].tvg_id.size() <= 160
          && items[0].in_my_pl is int
          && items[0].used_in is list && items[0].used_in.size() <= 50
          && items[0].alt_names is list && items[0].alt_names.size() <= 30
        ));
    }

    function isValidCatalogChunk(data) {
      return data.keys().hasAll(['index', 'items', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['index', 'items', 'createdAt', 'updatedAt'])
        && data.index is int && data.index >= 0 && data.index <= 500
        && isValidCatalogChannelItems(data.items)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCatalogStreamItems(items) {
      return items is list
        && items.size() <= 250
        && (items.size() == 0 || (
          items[0] is map
          && items[0].keys().hasAll(['id', 'channel_id', 'url', 'source_id', 'source_name', 'source_type', 'online', 'http_code', 'response_ms', 'checked_at', 'added_at'])
          && items[0].keys().hasOnly(['id', 'channel_id', 'url', 'source_id', 'source_name', 'source_type', 'online', 'http_code', 'response_ms', 'checked_at', 'added_at', 'diag_code', 'diag_reason', 'codec_warning'])
          && items[0].id is int
          && items[0].channel_id is int
          && items[0].url is string && items[0].url.size() <= 1500
          && (!('diag_code' in items[0]) || (items[0].diag_code is string && items[0].diag_code.size() <= 32))
          && (!('diag_reason' in items[0]) || (items[0].diag_reason is string && items[0].diag_reason.size() <= 220))
          && (!('codec_warning' in items[0]) || (items[0].codec_warning is string && items[0].codec_warning.size() <= 220))
        ));
    }

    function isValidCatalogStreamChunk(data) {
      return data.keys().hasAll(['index', 'items', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['index', 'items', 'createdAt', 'updatedAt'])
        && data.index is int && data.index >= 0 && data.index <= 500
        && isValidCatalogStreamItems(data.items)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStreamingSetting(data) {
      return data.keys().hasAll([
          'settingId', 'preset', 'mode', 'preferDirectOnTv', 'tryHttpsUpgrade',
          'protocolHint', 'proxyUserAgent', 'proxyFollowRedirects', 'proxyTimeoutSec',
          'proxyKeepAlive', 'proxyMaxSockets', 'proxyBufferKb', 'proxyRetryCount',
          'hlsUseWorkers', 'hlsLowLatency', 'hlsLiveSyncDurationCount', 'hlsMaxBufferLengthSec',
          'hlsMaxMaxBufferLengthSec', 'hlsBackBufferLengthSec', 'hlsStartFragPrefetch',
          'hlsManifestTimeoutSec', 'hlsManifestMaxRetry', 'hlsFragTimeoutSec', 'hlsFragMaxRetry',
          'hlsMaxBufferHoleMs', 'mpegtsUseWorker', 'mpegtsStashBuffer', 'mpegtsStashSizeKb',
          'mpegtsLiveLatencyChasing', 'mpegtsMaxLatencySec', 'mpegtsMinRemainSec',
          'attemptTimeoutSec', 'previewEnabled', 'previewDebounceMs', 'previewResumeDelayMs',
          'codecCheckDelaySec', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'settingId', 'preset', 'mode', 'preferDirectOnTv', 'tryHttpsUpgrade',
          'protocolHint', 'proxyUserAgent', 'proxyFollowRedirects', 'proxyTimeoutSec',
          'proxyKeepAlive', 'proxyMaxSockets', 'proxyBufferKb', 'proxyRetryCount',
          'hlsUseWorkers', 'hlsLowLatency', 'hlsLiveSyncDurationCount', 'hlsMaxBufferLengthSec',
          'hlsMaxMaxBufferLengthSec', 'hlsBackBufferLengthSec', 'hlsStartFragPrefetch',
          'hlsManifestTimeoutSec', 'hlsManifestMaxRetry', 'hlsFragTimeoutSec', 'hlsFragMaxRetry',
          'hlsMaxBufferHoleMs', 'mpegtsUseWorker', 'mpegtsStashBuffer', 'mpegtsStashSizeKb',
          'mpegtsLiveLatencyChasing', 'mpegtsMaxLatencySec', 'mpegtsMinRemainSec',
          'attemptTimeoutSec', 'previewEnabled', 'previewDebounceMs', 'previewResumeDelayMs',
          'codecCheckDelaySec', 'createdAt', 'updatedAt'
        ])
        && data.settingId is string && data.settingId == 'streaming'
        && data.preset is string && data.preset in ['vlc_smooth', 'balanced', 'low_latency', 'custom']
        && data.mode is string && data.mode in ['auto_proxy_first', 'auto_direct_first', 'proxy_only', 'direct_only']
        && data.preferDirectOnTv is bool
        && data.tryHttpsUpgrade is bool
        && data.protocolHint is string && data.protocolHint in ['auto', 'hls', 'mpegts', 'native']
        && data.proxyUserAgent is string && data.proxyUserAgent.size() <= 240
        && data.proxyFollowRedirects is int && data.proxyFollowRedirects >= 0 && data.proxyFollowRedirects <= 10
        && data.proxyTimeoutSec is int && data.proxyTimeoutSec >= 3 && data.proxyTimeoutSec <= 60
        && data.proxyKeepAlive is bool
        && data.proxyMaxSockets is int && data.proxyMaxSockets >= 4 && data.proxyMaxSockets <= 200
        && data.proxyBufferKb is int && data.proxyBufferKb >= 16 && data.proxyBufferKb <= 1024
        && data.proxyRetryCount is int && data.proxyRetryCount >= 0 && data.proxyRetryCount <= 5
        && data.hlsUseWorkers is bool
        && data.hlsLowLatency is bool
        && data.hlsLiveSyncDurationCount is int && data.hlsLiveSyncDurationCount >= 1 && data.hlsLiveSyncDurationCount <= 12
        && data.hlsMaxBufferLengthSec is int && data.hlsMaxBufferLengthSec >= 5 && data.hlsMaxBufferLengthSec <= 180
        && data.hlsMaxMaxBufferLengthSec is int && data.hlsMaxMaxBufferLengthSec >= 10 && data.hlsMaxMaxBufferLengthSec <= 360
        && data.hlsBackBufferLengthSec is int && data.hlsBackBufferLengthSec >= 0 && data.hlsBackBufferLengthSec <= 120
        && data.hlsStartFragPrefetch is bool
        && data.hlsManifestTimeoutSec is int && data.hlsManifestTimeoutSec >= 3 && data.hlsManifestTimeoutSec <= 60
        && data.hlsManifestMaxRetry is int && data.hlsManifestMaxRetry >= 0 && data.hlsManifestMaxRetry <= 10
        && data.hlsFragTimeoutSec is int && data.hlsFragTimeoutSec >= 5 && data.hlsFragTimeoutSec <= 60
        && data.hlsFragMaxRetry is int && data.hlsFragMaxRetry >= 0 && data.hlsFragMaxRetry <= 10
        && data.hlsMaxBufferHoleMs is int && data.hlsMaxBufferHoleMs >= 100 && data.hlsMaxBufferHoleMs <= 5000
        && data.mpegtsUseWorker is bool
        && data.mpegtsStashBuffer is bool
        && data.mpegtsStashSizeKb is int && data.mpegtsStashSizeKb >= 64 && data.mpegtsStashSizeKb <= 2048
        && data.mpegtsLiveLatencyChasing is bool
        && (data.mpegtsMaxLatencySec is int || data.mpegtsMaxLatencySec is float) && data.mpegtsMaxLatencySec >= 1 && data.mpegtsMaxLatencySec <= 20
        && (data.mpegtsMinRemainSec is int || data.mpegtsMinRemainSec is float) && data.mpegtsMinRemainSec >= 0.5 && data.mpegtsMinRemainSec <= 10
        && data.attemptTimeoutSec is int && data.attemptTimeoutSec >= 4 && data.attemptTimeoutSec <= 60
        && data.previewEnabled is bool
        && data.previewDebounceMs is int && data.previewDebounceMs >= 0 && data.previewDebounceMs <= 3000
        && data.previewResumeDelayMs is int && data.previewResumeDelayMs >= 0 && data.previewResumeDelayMs <= 3000
        && data.codecCheckDelaySec is int && data.codecCheckDelaySec >= 0 && data.codecCheckDelaySec <= 30
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUiSetting(data) {
      return data.keys().hasAll(['settingId', 'logoEnabled', 'logoOpacity', 'logoPulseEnabled', 'logoPulseSpeedSec', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['settingId', 'logoEnabled', 'logoOpacity', 'logoPulseEnabled', 'logoPulseSpeedSec', 'createdAt', 'updatedAt'])
        && data.settingId is string && data.settingId == 'ui'
        && data.logoEnabled is bool
        && data.logoOpacity is int && data.logoOpacity >= 0 && data.logoOpacity <= 100
        && data.logoPulseEnabled is bool
        && (data.logoPulseSpeedSec is int || data.logoPulseSpeedSec is float) && data.logoPulseSpeedSec >= 0 && data.logoPulseSpeedSec <= 10
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidIntList(list, maxLen) {
      return list is list
        && list.size() <= maxLen
        && (list.size() == 0 || (list[0] is int && list[0] >= 1 && list[0] <= 1000000));
    }

    function isValidApkReleasesList(items) {
      return items is list
        && items.size() <= 15
        && (items.size() == 0 || (
          items[0] is map
          && items[0].keys().hasAll(['id', 'versionCode', 'versionName', 'filename', 'size', 'sha256', 'changelog', 'mandatory', 'blocked', 'uploadedAt'])
          && items[0].keys().hasOnly(['id', 'versionCode', 'versionName', 'filename', 'size', 'sha256', 'changelog', 'mandatory', 'blocked', 'blockReason', 'source', 'githubRunId', 'externalApkUrl', 'uploadedAt'])
          && items[0].id is string && items[0].id.size() >= 1 && items[0].id.size() <= 80
          && items[0].versionCode is int && items[0].versionCode >= 1 && items[0].versionCode <= 1000000
          && items[0].versionName is string && items[0].versionName.size() >= 1 && items[0].versionName.size() <= 32
          && items[0].filename is string && items[0].filename.size() >= 1 && items[0].filename.size() <= 160
          && items[0].size is int && items[0].size >= 0
          && items[0].sha256 is string && items[0].sha256.size() <= 128
          && items[0].changelog is string && items[0].changelog.size() <= 1000
          && items[0].mandatory is bool
          && items[0].blocked is bool
          && (!('blockReason' in items[0]) || (items[0].blockReason is string && items[0].blockReason.size() <= 300))
          && (!('source' in items[0]) || (items[0].source is string && items[0].source in ['github', 'upload']))
          && (!('githubRunId' in items[0]) || (items[0].githubRunId is int && items[0].githubRunId >= 0))
          && (!('externalApkUrl' in items[0]) || (items[0].externalApkUrl is string && items[0].externalApkUrl.size() <= 500))
          && items[0].uploadedAt is int && items[0].uploadedAt >= 0
        ));
    }

    function isValidApkSetting(data) {
      return data.keys().hasAll([
          'settingId', 'lastVersionCode', 'lastVersionName',
          'minSupportedVersionCode', 'blockedVersionCodes',
          'blockMode', 'blockMessage', 'releases',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'settingId', 'lastVersionCode', 'lastVersionName',
          'minSupportedVersionCode', 'blockedVersionCodes',
          'blockMode', 'blockMessage', 'releases',
          'createdAt', 'updatedAt'
        ])
        && data.settingId is string && data.settingId == 'apk'
        && data.lastVersionCode is int && data.lastVersionCode >= 0 && data.lastVersionCode <= 1000000
        && data.lastVersionName is string && data.lastVersionName.size() <= 32
        && data.minSupportedVersionCode is int && data.minSupportedVersionCode >= 0 && data.minSupportedVersionCode <= 1000000
        && isValidIntList(data.blockedVersionCodes, 100)
        && data.blockMode is string && data.blockMode in ['hard', 'soft']
        && data.blockMessage is string && data.blockMessage.size() <= 300
        && isValidApkReleasesList(data.releases)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminSetting(data) {
      return data.keys().hasAll(['settingId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['settingId', 'githubRepo', 'githubBranch', 'adminPasswordHash', 'createdAt', 'updatedAt'])
        && isValidId(data.settingId)
        && (!('githubRepo' in data) || (data.githubRepo is string && data.githubRepo.size() <= 200))
        && (!('githubBranch' in data) || (data.githubBranch is string && data.githubBranch.size() <= 80))
        && (!('adminPasswordHash' in data) || (data.adminPasswordHash is string && data.adminPasswordHash.size() <= 200))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChannelHealthDiagnostics(items) {
      return items is list
        && items.size() <= 400
        && (items.size() == 0 || (
          items[0] is map
          && items[0].keys().hasAll(['url', 'status', 'code', 'ms', 'diagCode', 'reason', 'checkedAt'])
          && items[0].keys().hasOnly(['url', 'online', 'status', 'code', 'ms', 'diagCode', 'reason', 'contentType', 'hlsOk', 'segmentOk', 'codecWarning', 'checkedAt'])
          && items[0].url is string && items[0].url.size() <= 1500
          && items[0].status is string && items[0].status in ['online', 'offline', 'unknown']
          && items[0].diagCode is string && items[0].diagCode.size() <= 32
          && items[0].reason is string && items[0].reason.size() <= 220
        ));
    }

    function isValidChannelHealthIssues(items) {
      return items is list
        && items.size() <= 250
        && (items.size() == 0 || (
          items[0] is map
          && items[0].keys().hasAll(['channelKey', 'channelName', 'resolved', 'resolveCheckStatus', 'updatedAt', 'viewerErrors'])
          && items[0].keys().hasOnly(['channelKey', 'channelName', 'resolved', 'resolveCheckStatus', 'resolveCheckMessage', 'resolveAttemptedAt', 'updatedAt', 'viewerErrors'])
          && items[0].channelKey is string && items[0].channelKey.size() <= 200
          && items[0].channelName is string && items[0].channelName.size() <= 200
          && items[0].resolved is bool
          && items[0].resolveCheckStatus is string && items[0].resolveCheckStatus in ['none', 'verified_ok', 'still_broken_after_resolve']
          && items[0].viewerErrors is list && items[0].viewerErrors.size() <= 10
        ));
    }

    function isValidChannelHealthDoc(data) {
      return data.keys().hasAll(['docId', 'diagnostics', 'issues', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['docId', 'diagnostics', 'issues', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.docId is string && data.docId == 'main'
        && isValidChannelHealthDiagnostics(data.diagnostics)
        && isValidChannelHealthIssues(data.issues)
        && data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ===== CONNECTION CHECK =====
    match /test/connection {
      allow get: if isSignedIn();
    }

    // ===== ADMINS =====
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isBootstrappedAdmin()
        && isValidId(userId)
        && isValidAdminRole(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time;
      allow update: if isBootstrappedAdmin()
        && isValidId(userId)
        && isValidAdminRole(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isBootstrappedAdmin() && isValidId(userId);
    }

    // ===== INVITES (Google Email invitations with pre-assigned playlists) =====
    match /invites/{inviteId} {
      allow get: if isValidEmailHash(inviteId) && (isAdmin() || isInvitedEmailOwner(inviteId));
      allow list: if isBootstrappedAdmin();
      allow create: if isVerifiedEmail()
        && isValidEmailHash(inviteId)
        && isValidInvite(incoming())
        && incoming().emailHash == inviteId
        && incoming().invitedByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin()
        && existsAfter(/databases/$(database)/documents/invites/$(inviteId)/private/info);
      allow update: if isVerifiedEmail()
        && isValidEmailHash(inviteId)
        && isValidInvite(incoming())
        && incoming().emailHash == existing().emailHash
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'playlists', 'enabled', 'claimedUid', 'updatedAt'])) ||
          (isInvitedEmailOwner(inviteId)
            && incoming().claimedUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['claimedUid', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidEmailHash(inviteId);

      match /private/info {
        allow get: if isValidEmailHash(inviteId)
          && (isAdmin() || (isVerifiedEmail() && existing().email == request.auth.token.email.lower()));
        allow list: if false;
        allow create: if isAdmin()
          && isValidEmailHash(inviteId)
          && isValidInvitePrivateInfo(incoming())
          && incoming().emailHash == inviteId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isAdmin()
          && isValidEmailHash(inviteId)
          && isValidInvitePrivateInfo(incoming())
          && incoming().emailHash == existing().emailHash
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if isAdmin() && isValidEmailHash(inviteId);
      }
    }

    // ===== USERS =====
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (isBootstrappedAdmin() || resource.data.uid == request.auth.uid);

      allow create: if isVerifiedEmail()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().uid == userId) ||
          (
            isOwner(userId)
            && incoming().uid == request.auth.uid
            && incoming().role == 'user'
            && existsAfter(/databases/$(database)/documents/users/$(userId)/private/info)
            && (
              (
                !('inviteId' in incoming())
                && incoming().enabled == false
                && incoming().playlists.size() == 0
              ) ||
              (
                'inviteId' in incoming()
                && isInvitedEmailOwner(incoming().inviteId)
                && incoming().enabled == get(/databases/$(database)/documents/invites/$(incoming().inviteId)).data.enabled
                && incoming().playlists == get(/databases/$(database)/documents/invites/$(incoming().inviteId)).data.playlists
              )
            )
          )
        );

      allow update: if isVerifiedEmail()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['login', 'name', 'playlists', 'enabled', 'role', 'inviteId', 'lastPing', 'lastUa', 'updatedAt'])) ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().enabled == existing().enabled
            && incoming().playlists == existing().playlists
            && incoming().login == existing().login
            && (!('lastPing' in incoming()) || incoming().lastPing == request.time)
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'lastPing', 'lastUa', 'updatedAt'])
          )
        );

      allow delete: if isAdmin() && isValidId(userId);

      // Isolated PII subcollection
      match /private/info {
        allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isVerifiedEmail()
          && isValidId(userId)
          && isValidPrivateInfo(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (isAdmin() || (isOwner(userId) && incoming().uid == request.auth.uid));
        allow update: if isVerifiedEmail()
          && isValidId(userId)
          && isValidPrivateInfo(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])) ||
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']))
          );
        allow delete: if isAdmin() && isValidId(userId);
      }

      // Admin-only password hashes for local TV viewer credentials
      match /private/credentials {
        allow get: if isValidId(userId) && isAdmin();
        allow list: if false;
        allow create: if isAdmin()
          && isValidId(userId)
          && isValidUserCredentials(incoming())
          && incoming().uid == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isAdmin()
          && isValidId(userId)
          && isValidUserCredentials(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['passwordHash', 'updatedAt']);
        allow delete: if isAdmin() && isValidId(userId);
      }
    }

    // ===== CHANNEL ALERTS (Unavailable channel reports from viewers) =====
    match /channel_alerts/{alertId} {
      allow get: if isValidId(alertId) && (isOwner(alertId) || isAdmin());
      allow list: if isSignedIn() && (isBootstrappedAdmin() || resource.data.uid == request.auth.uid);

      allow create: if isVerifiedEmail()
        && isValidId(alertId)
        && isValidChannelAlert(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(alertId) && incoming().uid == request.auth.uid && incoming().resolved == false)
        );

      allow update: if isVerifiedEmail()
        && isValidId(alertId)
        && isValidChannelAlert(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['resolved', 'items', 'unavailableCount', 'totalChannels', 'updatedAt'])) ||
          (isOwner(alertId)
            && incoming().resolved == false
            && incoming().diff(existing()).affectedKeys().hasOnly(['userLogin', 'userName', 'totalChannels', 'unavailableCount', 'items', 'resolved', 'updatedAt']))
        );

      allow delete: if isAdmin() && isValidId(alertId);
    }

    // ===== GLOBAL CHANNEL CATEGORIES =====
    match /categories/{categoryId} {
      allow get, list: if isVerifiedEmail();
      allow create: if isAdmin()
        && isValidId(categoryId) && isValidCategory(incoming())
        && incoming().id == categoryId
        && incoming().createdByUid == request.auth.uid
        && incoming().updatedByUid == request.auth.uid
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(categoryId) && isValidCategory(incoming())
        && incoming().id == existing().id
        && incoming().createdByUid == existing().createdByUid
        && incoming().updatedByUid == request.auth.uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedByUid', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    // ===== CLOUD META MANIFEST (Admin-only) =====
    match /cloud_meta/{docId} {
      allow get: if isValidId(docId) && docId == 'manifest' && isAdmin();
      allow list: if false;
      allow create: if isAdmin()
        && isValidId(docId)
        && docId == 'manifest'
        && isValidCloudManifest(incoming())
        && incoming().docId == docId
        && incoming().updatedByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(docId)
        && docId == 'manifest'
        && isValidCloudManifest(incoming())
        && incoming().docId == existing().docId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().updatedByUid == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['playlists', 'sourceIds', 'sourceIndexIds', 'epgIds', 'localUserIds', 'catalogChannelChunks', 'catalogStreamChunks', 'revision', 'updatedByUid', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(docId);
    }

    // ===== PLAYLISTS & CHUNKED CHANNELS =====
    match /playlists/{playlistId} {
      allow get: if isValidPlaylistId(playlistId) && (isAdmin() || isViewerWithPlaylist(playlistId));
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidPlaylistId(playlistId)
        && isValidPlaylistMeta(incoming())
        && incoming().id == playlistId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidPlaylistId(playlistId)
        && isValidPlaylistMeta(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'channelCount', 'chunkCount', 'updatedAt']);
      allow delete: if isAdmin() && isValidPlaylistId(playlistId);

      match /chunks/{chunkId} {
        allow get: if isValidPlaylistId(playlistId) && isValidId(chunkId) && (isAdmin() || isViewerWithPlaylist(playlistId));
        allow list: if isBootstrappedAdmin();
        allow create: if isAdmin()
          && isValidPlaylistId(playlistId)
          && isValidId(chunkId)
          && isValidPlaylistChunk(incoming())
          && incoming().playlistId == playlistId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isAdmin()
          && isValidPlaylistId(playlistId)
          && isValidId(chunkId)
          && isValidPlaylistChunk(incoming())
          && incoming().playlistId == existing().playlistId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['index', 'items', 'updatedAt']);
        allow delete: if isAdmin() && isValidPlaylistId(playlistId) && isValidId(chunkId);
      }
    }

    // ===== PARSER SOURCES & SOURCE INDEX CACHE (Admin-only) =====
    match /sources/{sourceId} {
      allow get: if isValidId(sourceId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(sourceId)
        && isValidStreamSource(incoming())
        && incoming().id == sourceId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(sourceId)
        && isValidStreamSource(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'type', 'url', 'enabled', 'userAgent', 'referer', 'origin', 'timeoutSec', 'ignoreTlsErrors', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(sourceId);
    }

    match /source_index/{sourceId} {
      allow get: if isValidId(sourceId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(sourceId)
        && isValidSourceIndexMeta(incoming())
        && incoming().sourceId == sourceId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(sourceId)
        && isValidSourceIndexMeta(incoming())
        && incoming().sourceId == existing().sourceId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['count', 'chunkCount', 'indexedAt', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(sourceId);

      match /chunks/{chunkId} {
        allow get: if isValidId(sourceId) && isValidId(chunkId) && isAdmin();
        allow list: if isBootstrappedAdmin();
        allow create: if isAdmin()
          && isValidId(sourceId)
          && isValidId(chunkId)
          && isValidSourceIndexChunk(incoming())
          && incoming().sourceId == sourceId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isAdmin()
          && isValidId(sourceId)
          && isValidId(chunkId)
          && isValidSourceIndexChunk(incoming())
          && incoming().sourceId == existing().sourceId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['index', 'items', 'updatedAt']);
        allow delete: if isAdmin() && isValidId(sourceId) && isValidId(chunkId);
      }
    }

    // ===== EPG SOURCES (Admin-only) =====
    match /epg_sources/{epgId} {
      allow get: if isValidId(epgId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(epgId)
        && isValidEpgSourceDoc(incoming())
        && incoming().id == epgId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(epgId)
        && isValidEpgSourceDoc(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'url', 'enabled', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(epgId);
    }

    // ===== CATALOG SUMMARY & CHUNKS (Admin-only) =====
    match /catalog_summary/{docId} {
      allow get: if isValidId(docId) && docId == 'main' && isAdmin();
      allow list: if false;
      allow create: if isAdmin()
        && isValidId(docId)
        && docId == 'main'
        && isValidCatalogSummary(incoming())
        && incoming().docId == docId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(docId)
        && docId == 'main'
        && isValidCatalogSummary(incoming())
        && incoming().docId == existing().docId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['nextChannelId', 'nextStreamId', 'nextSourceId', 'channelChunkCount', 'streamChunkCount', 'sources', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(docId);
    }

    match /catalog_chunks/{chunkId} {
      allow get: if isValidId(chunkId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(chunkId)
        && isValidCatalogChunk(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(chunkId)
        && isValidCatalogChunk(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['index', 'items', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(chunkId);
    }

    match /catalog_stream_chunks/{chunkId} {
      allow get: if isValidId(chunkId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(chunkId)
        && isValidCatalogStreamChunk(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(chunkId)
        && isValidCatalogStreamChunk(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['index', 'items', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(chunkId);
    }

    // ===== STREAMING, UI & APK SETTINGS (Verified users & Admins read; Admins write) =====
    match /app_settings/{settingId} {
      allow get: if isValidId(settingId) && settingId in ['streaming', 'ui', 'apk'] && isVerifiedEmail();
      allow list: if false;
      allow create: if isAdmin()
        && isValidId(settingId)
        && (
          (settingId == 'streaming' && isValidStreamingSetting(incoming())) ||
          (settingId == 'ui' && isValidUiSetting(incoming())) ||
          (settingId == 'apk' && isValidApkSetting(incoming()))
        )
        && incoming().settingId == settingId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(settingId)
        && (
          (settingId == 'streaming'
            && isValidStreamingSetting(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'preset', 'mode', 'preferDirectOnTv', 'tryHttpsUpgrade',
              'protocolHint', 'proxyUserAgent', 'proxyFollowRedirects', 'proxyTimeoutSec',
              'proxyKeepAlive', 'proxyMaxSockets', 'proxyBufferKb', 'proxyRetryCount',
              'hlsUseWorkers', 'hlsLowLatency', 'hlsLiveSyncDurationCount', 'hlsMaxBufferLengthSec',
              'hlsMaxMaxBufferLengthSec', 'hlsBackBufferLengthSec', 'hlsStartFragPrefetch',
              'hlsManifestTimeoutSec', 'hlsManifestMaxRetry', 'hlsFragTimeoutSec', 'hlsFragMaxRetry',
              'hlsMaxBufferHoleMs', 'mpegtsUseWorker', 'mpegtsStashBuffer', 'mpegtsStashSizeKb',
              'mpegtsLiveLatencyChasing', 'mpegtsMaxLatencySec', 'mpegtsMinRemainSec',
              'attemptTimeoutSec', 'previewEnabled', 'previewDebounceMs', 'previewResumeDelayMs',
              'codecCheckDelaySec', 'updatedAt'
            ])) ||
          (settingId == 'ui'
            && isValidUiSetting(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['logoEnabled', 'logoOpacity', 'logoPulseEnabled', 'logoPulseSpeedSec', 'updatedAt'])) ||
          (settingId == 'apk'
            && isValidApkSetting(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'lastVersionCode', 'lastVersionName', 'minSupportedVersionCode',
              'blockedVersionCodes', 'blockMode', 'blockMessage', 'releases', 'updatedAt'
            ]))
        )
        && incoming().settingId == existing().settingId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(settingId);
    }

    // ===== ADMIN SETTINGS (Admin-only) =====
    match /admin_settings/{settingId} {
      allow get: if isValidId(settingId) && isAdmin();
      allow list: if false;
      allow create: if isAdmin()
        && isValidId(settingId)
        && isValidAdminSetting(incoming())
        && incoming().settingId == settingId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(settingId)
        && isValidAdminSetting(incoming())
        && incoming().settingId == existing().settingId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['githubRepo', 'githubBranch', 'adminPasswordHash', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(settingId);
    }

    // ===== CHANNEL HEALTH & VERIFIED RESOLVE STATE (Admin-only) =====
    match /channel_health/{docId} {
      allow get: if isValidId(docId) && docId == 'main' && isAdmin();
      allow list: if false;
      allow create: if isAdmin()
        && isValidId(docId)
        && docId == 'main'
        && isValidChannelHealthDoc(incoming())
        && incoming().docId == docId
        && incoming().updatedByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(docId)
        && docId == 'main'
        && isValidChannelHealthDoc(incoming())
        && incoming().docId == existing().docId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().updatedByUid == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['diagnostics', 'issues', 'updatedByUid', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(docId);
    }
  }
}
